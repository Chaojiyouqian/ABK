- name: 缓存 Clang r563880c
  uses: actions/cache@v5
  with:
    path: oneplus_workspace/kernel_workspace/kernel_platform/prebuilts/clang/host/linux-x86/clang-r563880c
    key: clang-r563880c-${{ runner.os }}
    restore-keys: |
      clang-r563880c-${{ runner.os }}-

- name: 下载并安装 Clang (r563880c)
  shell: bash
  run: |
    set -euo pipefail
    WORKSPACE="$GITHUB_WORKSPACE/oneplus_workspace"
    KERNEL_ROOT="$WORKSPACE/kernel_workspace/kernel_platform"
    
    # Clang r563880c（从 android16-qpr2-release 分支下载）
    CLANG_VERSION="clang-r563880c"
    CLANG_DIR="$KERNEL_ROOT/prebuilts/clang/host/linux-x86/$CLANG_VERSION"
    
    # 检查是否已存在
    if [ -d "$CLANG_DIR" ] && [ -f "$CLANG_DIR/bin/clang" ]; then
      echo "✅ Clang r563880c 已存在: $CLANG_DIR"
      $CLANG_DIR/bin/clang --version | head -1
      exit 0
    fi
    
    echo "========================================"
    echo " 下载 AOSP Clang r563880c"
    echo "========================================"
    
    # 创建目录
    mkdir -p "$(dirname "$CLANG_DIR")"
    cd "$(dirname "$CLANG_DIR")"
    
    echo "正在从 AOSP (android16-qpr2-release) 下载 Clang r563880c..."
    curl -fsSL \
      "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/android16-qpr2-release/$CLANG_VERSION.tar.gz" \
      -o "$CLANG_VERSION.tar.gz"
    
    if [ -f "$CLANG_VERSION.tar.gz" ]; then
      mkdir -p "$CLANG_VERSION"
      tar -xzf "$CLANG_VERSION.tar.gz" -C "$CLANG_VERSION"
      rm -f "$CLANG_VERSION.tar.gz"
      echo "✅ Clang r563880c 下载并解压成功"
    else
      echo "::error::Clang r563880c 下载失败"
      exit 1
    fi
    
    # 验证安装
    if [ -f "$CLANG_DIR/bin/clang" ]; then
      echo "========================================"
      echo " Clang r563880c 安装验证"
      echo "========================================"
      $CLANG_DIR/bin/clang --version | head -3
      echo "========================================"
      echo "✅ Clang r563880c 安装完成"
    else
      echo "::error::Clang r563880c 安装失败，未找到 clang 二进制文件"
      ls -la "$CLANG_DIR/" || true
      ls -la "$CLANG_DIR/bin/" 2>/dev/null || true
      exit 1
    fi

